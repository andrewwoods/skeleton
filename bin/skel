#!/usr/bin/env php
<?php

require  dirname(__FILE__, 2) . '/vendor/autoload.php';

use Symfony\Component\Console\Application;
use Symfony\Component\Console\Helper\FormatterHelper;

use Skel\Commands\CreateDocsCommand;
use Skel\Commands\CreateLicenseCommand;
use Skel\Commands\CreateGitCommand;
use Skel\Commands\WriteArticleCommand;
use Skel\Commands\WriteTalkCommand;
use Skel\Commands\PhpClassCommand;
use Skel\Path;
use XdgBaseDir\Xdg;

$skeletonPath = dirname(__FILE__, 2);
$userProjectPath = getcwd();

$path = new Path($skeletonPath, $userProjectPath, new Xdg());

try {

    $application = new Application('Skeleton', '0.4.0');

    // Register your commands
    $application->add(new CreateDocsCommand($path));
    $application->add(new CreateLicenseCommand($path));
    $application->add(new CreateGitCommand($path));
    $application->add(new WriteTalkCommand($path));
    $application->add(new WriteArticleCommand($path));
    $application->add(new PhpClassCommand($path));

    $application->run();

} catch (Exception $exception) {
    $messages = ['Error'];
    $messages[] = $exception->getMessage();

    $format = new FormatterHelper();
    $formatted = $format->formatBlock($messages, 'error');

    echo $formatted . "\n";
}

